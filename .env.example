# ==============================================================================
# VARIÁVEIS DE AMBIENTE — EMPÓRIO HENZ
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e preencha com valores reais:
# cp .env.example .env
#
# DICA DE SEGURANÇA EM PRODUÇÃO:
# Gere segredos criptograficamente seguros antes de subir o ambiente:
# JWT_SECRET:       openssl rand -base64 32
# POSTGRES_PASSWORD: openssl rand -base64 24
# ==============================================================================

# --- PORTAS & SERVIÇOS ---
# Portas públicas de entrada expostas no Nginx / Web
# Desenvolvimento: PORT_HTTP=3000
# Produção (VM):   PORT_HTTP=80 e PORT_HTTPS=443
PORT_HTTP=3000
PORT_HTTPS=443

# Porta interna da API Backend (em produção, o backend não expõe portas públicas)
PORT=3001
BACKEND_PORT=3001

# Segredo JWT (OBRIGATÓRIO alterar em produção para pelo menos 32 caracteres)
JWT_SECRET=emporio-henz-default-jwt-secret-at-least-32-chars-long

# Ambiente de execução: "development" ou "production"
NODE_ENV=development

# --- BANCO DE DADOS (POSTGRESQL) ---
# Credenciais do PostgreSQL
POSTGRES_USER=emporio_admin
POSTGRES_PASSWORD=altere_para_uma_senha_forte_e_segura
POSTGRES_DB=emporio_henz
POSTGRES_PORT=5432

# Host do banco:
# - No Docker Compose: use 'postgres' (resolvido na rede interna emporio_net)
# - Em desenvolvimento local sem Docker: use 'localhost'
POSTGRES_HOST=postgres

# Obs: A conexão com o banco é montada automaticamente a partir das variáveis acima
# (postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB})


# --- ACESSO REMOTO AO BANCO (PRODUÇÃO) ---
# Em produção, a porta 5432 vincula exclusivamente a 127.0.0.1 (loopback) da VM,
# não ficando exposta à internet pública.
# Para conectar DBeaver / TablePlus / pgAdmin ao banco da VM, utilize um túnel SSH:
#   ssh -L 5432:localhost:5432 usuario@ip-da-vm
# Em seguida, conecte sua ferramenta localmente em 127.0.0.1:5432.
