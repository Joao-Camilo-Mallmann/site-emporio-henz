# ==============================================================================
# VARIÁVEIS DE AMBIENTE — EMPÓRIO HENZ
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e preencha com valores reais:
# cp .env.example .env

# --- PORTAS & SERVIÇOS ---
# Porta pública exposta (dev: 3000 | prod na VPS: 80)
PORT_HTTP=3000

# Porta interna do servidor Backend Bun (padrão: 3001)
PORT=3001

# Segredo de assinatura dos tokens JWT (mínimo de 32 caracteres).
# Gere um valor próprio com: openssl rand -hex 32
# Obrigatório: o backend não sobe sem ele. Troque este placeholder em produção.
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Ambiente de execução (development | production)
NODE_ENV=development

# Diretório onde o backend grava as fotos de produto e amostras de variação (RNF02).
# Vazio usa o padrão <cwd>/uploads: no container é /app/uploads (volume uploads_data);
# na execução local sem Docker é backend/uploads (ignorado pelo git).
UPLOADS_DIR=

# URL base / Host da API consumida pelo Frontend (sem /api/v1, que já é fixo no cliente Axios)
# - Em dev local: http://localhost:3001
# - Em produção na VPS: http://177.44.248.90
VITE_API_URL=http://localhost:3001

# --- BANCO DE DADOS (POSTGRESQL) ---
# Credenciais do PostgreSQL
POSTGRES_USER=emporio_admin
POSTGRES_PASSWORD=altere_para_uma_senha_forte_e_segura
POSTGRES_DB=emporio_henz
POSTGRES_PORT=5432

# Host do banco:
# - No Docker Compose: use 'postgres' (nome do serviço na rede interna)
# - Em desenvolvimento local sem Docker: use 'localhost'
POSTGRES_HOST=postgres

# A URL de conexão é montada pelo backend a partir das variáveis POSTGRES_* acima.
