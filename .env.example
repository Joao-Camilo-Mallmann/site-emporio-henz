# ==============================================================================
# Variáveis de Ambiente de Exemplo - Empório Henz
# Copie este arquivo para .env caso deseje sobrescrever variáveis localmente:
# cp .env.example .env
# ==============================================================================

# Backend (Bun HTTP Server)
PORT=3001

# Frontend (Nginx / Vite)
WEB_PORT=3000
VITE_API_URL=http://localhost:3001

# Banco de Dados (PostgreSQL)
POSTGRES_USER=emporio
POSTGRES_PASSWORD=emporiopass
POSTGRES_DB=emporio_henz
POSTGRES_PORT=5432

# URL de Conexão com o Banco de Dados (PostgreSQL)
# Para conexão interna entre contêineres Docker (Compose):
DATABASE_URL=postgres://emporio:emporiopass@postgres:5432/emporio_henz
# Para conexão direta da máquina host (local):
# DATABASE_URL=postgres://emporio:emporiopass@localhost:5432/emporio_henz
