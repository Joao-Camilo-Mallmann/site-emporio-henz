# ==============================================================================
# VARIÁVEIS DE AMBIENTE — EMPÓRIO HENZ
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e preencha com valores reais:
# cp .env.example .env

# --- PORTAS & SERVIÇOS ---
# Porta pública exposta (dev: 3000 | prod na VPS: 80)
PORT_HTTP=3000

# Porta interna do servidor Backend Bun (padrão: 3001)
PORT=3001

# Ambiente de execução (development | production)
NODE_ENV=development

# --- BANCO DE DADOS (POSTGRESQL) ---
# Credenciais do PostgreSQL
POSTGRES_USER=emporio_admin
POSTGRES_PASSWORD=altere_para_uma_senha_forte_e_segura
POSTGRES_DB=emporio_henz
POSTGRES_PORT=5432

# Host do banco:
# - No Docker Compose: use 'postgres' (nome do serviço na rede interna)
# - Em desenvolvimento local sem Docker: use 'localhost'
POSTGRES_HOST=postgres

# String de conexão completa com o banco de dados
DATABASE_URL=postgres://emporio_admin:altere_para_uma_senha_forte_e_segura@postgres:5432/emporio_henz

# --- FRONTEND (VUE 3 / VITE) ---
# URL base da API para o frontend:
# - Em produção com Docker + Nginx: deixe vazio "" (as requisições relativas vão para /api via Nginx)
# - Em desenvolvimento local fora do Docker: http://localhost:3001
VITE_API_URL=
