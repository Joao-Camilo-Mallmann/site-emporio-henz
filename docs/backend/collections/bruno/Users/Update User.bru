meta {
  name: Atualizar Usuário
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/users/:id
  body: json
  auth: bearer
}

params:path {
  id: 00000000-0000-0000-0000-000000000000
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "fullName": "Carlos Eduardo Atualizado",
    "phone": "(51) 99888-0000",
    "city": "Estrela",
    "role": 2
  }
}
