meta {
  name: Listar Vendedores (Paginado)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/vendedores?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{token}}
}

docs {
  Listagem paginada de usuários ativos com perfil Vendedor (`role = 2`).
  Exclusiva do Administrador (demais usuários recebem HTTP 403 Forbidden).
  Utiliza o padrão de paginação `src/lib/pagination.ts`.
  Resposta 200: `{ data: [...], pagination: { page, limit, total, totalPages } }`.
}
