{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@database/*": ["../../packages/database/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
